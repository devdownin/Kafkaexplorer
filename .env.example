# Copy to `.env` at the repository root — docker compose reads it automatically for every
# bundled stack. Everything here has a working default, so `.env` is optional; it exists
# so that changing where the stack is published does not mean editing six compose files.
#
#     cp .env.example .env
#
# A one-off override needs no file at all:
#
#     EXPLORER_PORT=9080 docker compose up -d

# ── Where the stack is published ─────────────────────────────────────────────────────
# Interface the published ports bind to. The default is the loopback: this application
# has no authentication and `POST /api/config` can repoint the Kafka cluster at runtime,
# so the Docker default of 0.0.0.0 handed it to the whole local network on a plain `up`.
# Set 0.0.0.0 to expose it deliberately — on a trusted network, and knowing the above.
BIND_ADDR=127.0.0.1

# Host ports. 8080 and 9092 are the two most contended ports on a developer machine, and
# a conflict there used to mean editing every stack by hand.
EXPLORER_PORT=8080
KAFKA_PORT=9092

# docker-compose-kafka4.yml only.
SCHEMA_REGISTRY_PORT=8081

# docker-compose-llm.yml only.
OLLAMA_PORT=11434

# docker-compose-dev.yml only (the Vite dev server).
VITE_PORT=5173

# ── Notes ────────────────────────────────────────────────────────────────────────────
# KAFKA_PORT also rewrites the broker's advertised PLAINTEXT_HOST listener, so a host
# client told to connect on the new port is not redirected back to 9092. The in-network
# listener (kafka:29092) is unaffected and is what the app itself uses.
#
# docker-compose-spectra.yml defaults EXPLORER_PORT to 8090 instead, because SpectraLLM's
# own API publishes on host 8080 in that stack.
