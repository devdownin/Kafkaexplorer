# Copy to `.env` at the repository root — docker compose reads it automatically for every
# bundled stack. Everything here has a working default, so `.env` is optional; it exists
# so that changing where the stack is published does not mean editing six compose files.
#
#     cp .env.example .env
#
# A one-off override needs no file at all:
#
#     EXPLORER_PORT=9080 docker compose up -d

# ── Where the stack is published ─────────────────────────────────────────────────────
# Interface the published ports bind to. The default is the loopback: this application
# has no authentication and `POST /api/config` can repoint the Kafka cluster at runtime,
# so the Docker default of 0.0.0.0 handed it to the whole local network on a plain `up`.
# Set 0.0.0.0 to expose it deliberately — on a trusted network, and knowing the above.
BIND_ADDR=127.0.0.1

# Host ports. 8080 and 9092 are the two most contended ports on a developer machine, and
# a conflict there used to mean editing every stack by hand.
EXPLORER_PORT=8080
KAFKA_PORT=9092

# docker-compose-kafka4.yml only.
SCHEMA_REGISTRY_PORT=8081

# docker-compose-llm.yml only.
OLLAMA_PORT=11434

# The window Ollama gives a model, and the reason it is set at all: it defaults to 4 096 tokens
# unless the machine has the VRAM for more, the app's OpenAI-compatible request carries no
# `num_ctx` (that endpoint would not read one from the body), and the shipped prompt budget is
# 120 000 characters — about 30 000 tokens. Ollama does not refuse the excess, it drops the
# oldest messages until the prompt fits and logs that at DEBUG. So the analysis ran on a
# fraction of its input, silently. Raise this and EXPLORER_PROMPT_CHAR_BUDGET together, or
# neither: the KV cache is what a wider window costs (~2 GB here for a 7B model).
OLLAMA_CONTEXT_LENGTH=16384

# docker-compose-dev.yml only (the Vite dev server).
VITE_PORT=5173

# ── Limites de ressources (docker-compose.limits.yml uniquement) ─────────────────────
# Lues seulement si l'on superpose l'overlay :
#     docker compose -f docker-compose.yml -f docker-compose.limits.yml up -d
# Sans lui, aucune limite n'est posée — et `-XX:MaxRAMPercentage=75.0`, présent dans les
# deux images, lit alors la mémoire de l'HÔTE : sur un poste à 32 Go la JVM se croit
# autorisée à 24 Go. C'est la limite conteneur qui donne son sens à ce réglage.
# Un conteneur tué en code 137 sous charge veut dire que la limite a été atteinte :
# augmenter la valeur, plutôt que de retirer l'overlay.
EXPLORER_MEM_LIMIT=2g
EXPLORER_CPUS=2.0
KAFKA_MEM_LIMIT=1500m
KAFKA_CPUS=1.5

# ── docker-compose-spectra-hub.yml only (Kafka Explorer + SpectraLLM, from Docker Hub) ──
# That stack pulls both projects' published images and builds nothing. Everything below has
# a working default; these lines exist so that pinning a version, moving a port or serving a
# smaller model does not mean editing the compose file.

# Where the images come from, and which version. Pinned rather than `latest`: `latest` serves
# whatever was published the day of your first pull, not what this checkout was tested with.
EXPLORER_IMAGE_NAMESPACE=compagnonsdudev
EXPLORER_IMAGE_TAG=1.8.9
SPECTRA_IMAGE_NAMESPACE=compagnonsdudev
SPECTRA_IMAGE_TAG=0.9.0
LLAMA_CPP_IMAGE_TAG=server-b9828
CHROMADB_IMAGE_TAG=1.5.9

# Host ports for the SpectraLLM half. The Explorer keeps EXPLORER_PORT (8080) there, so the
# Spectra API moves to 8081 and its web UI to 8088. chromadb and the two llama-server ports
# are NOT published: llama-server has no authentication, and chromadb's port is read *and*
# write access to the ingested corpus.
SPECTRA_UI_PORT=8088
SPECTRA_API_PORT=8081

# The chat model, served by llm-chat and installed by spectra-api on first boot (~4.7 GB).
# A different one: change both lines and drop the GGUF into the volume yourself, or install
# it from the Spectra UI's Model Hub — the automatic install only knows the default.
LLM_CHAT_MODEL_FILE=Qwen2.5-7B-Instruct-Q4_K_M.gguf
LLM_CHAT_MODEL_NAME=qwen2.5-7b-instruct
SPECTRA_AUTO_INSTALL_MODELS=true

# TOTAL context of the chat server, split across LLM_PARALLEL slots: 16384/2 = 8192 tokens
# per request. EXPLORER_PROMPT_CHAR_BUDGET is sized against that window (16 000 characters is
# ~4k tokens, leaving the rest of the slot for the answer) — move the two together, or the
# model silently sees a truncated prompt. Empty LLM_CONTEXT = llama-server decides.
LLM_CONTEXT=16384
LLM_PARALLEL=2
EXPLORER_PROMPT_CHAR_BUDGET=16000
# GPU offload, passed straight to llama-server:
# LLM_CHAT_EXTRA_ARGS=--n-gpu-layers 99

# The embedding model — 81 MB, fetched once by the `spectra-models` one-shot. It is the one
# model the API does not install by itself. Without it the Explorer's audits still work (they
# carry their context inline); what stops working is ingesting documents into Spectra.
LLM_EMBED_MODEL_FILE=embed.gguf
SPECTRA_EMBED_MODEL_URL=https://huggingface.co/nomic-ai/nomic-embed-text-v1.5-GGUF/resolve/main/nomic-embed-text-v1.5.Q4_K_M.gguf
# The alias llama-server answers to; spectra-api asks for this name, so the two move together.
LLM_EMBED_MODEL_NAME=nomic-embed-text
# Concurrent embedding requests. Higher than the chat server's because an embedding is short:
# ingestion sends many small ones where a chat request holds a slot for minutes.
LLM_EMBED_PARALLEL=4
# GPU offload for the embedding server, passed straight to llama-server. The GPU overlay sets
# it to --n-gpu-layers 99; empty here so the CPU stack stays the default.
LLM_EMBED_EXTRA_ARGS=

# Pin the digests, and a corrupt or substituted download is refused instead of served: the
# one-shot deletes the file and says so. Left empty it prints the digest it obtained, ready to
# copy here. The chat URL is empty because the DEFAULT chat model is spectra-api's to install —
# name one to serve a different model (docker-compose-spectra-hub.small.yml is that, as a flag).
SPECTRA_EMBED_MODEL_SHA256=
SPECTRA_CHAT_MODEL_URL=
SPECTRA_CHAT_MODEL_SHA256=

# A 7B model quantised to Q4 answers a Process Mining prompt in minutes on CPU, and a request
# timeout is terminal on that path (retrying replays the whole prompt). Keep the two in step:
# the shorter of them is the one that decides. EXPLORER_LLM_TIMEOUT and
# EXPLORER_PROMPT_CHAR_BUDGET are read by docker-compose-llm.yml and docker-compose-spectra.yml
# too — the same arithmetic applies wherever a local model answers.
EXPLORER_LLM_TIMEOUT=300
SPECTRA_GENERATION_TIMEOUT=300

# Indexing the broker's own topics into Spectra's corpus. Until this is on the two applications
# only share a model. Turn it on with the OVERLAY rather than with this variable —
# docker-compose-spectra-hub.ingest.yml sets the same flag and adds the two dependencies that
# make it safe on a cold stack (wait for the seeding, or a consumer subscribing to a topic that
# does not exist yet creates it with one partition instead of three; wait for llm-embed, or the
# demo history goes to `<topic>.DLT` while the embedding model is still downloading).
SPECTRA_INGEST_KAFKA=false
SPECTRA_INGEST_TOPICS=demo.orders.1.received,demo.orders.2.validated,demo.orders.3.enriched,demo.customers
SPECTRA_INGEST_METADATA_FIELDS=id,state,customer_id
# Empty indexes the whole payload, which is right for records whose value IS the document.
# Name a field when the payload carries a real text body.
SPECTRA_INGEST_CONTENT_FIELD=
SPECTRA_INGEST_GROUP_ID=spectra-ingestion

# One collection name, written by the ingestion and read by the Explorer's audits, so the two
# halves line up from a single variable.
SPECTRA_STREAM_COLLECTION=spectra_stream

# The Spectra API's JVM. It runs beside a broker, a vector store and two llama.cpp servers, so
# the heap is capped rather than left to take a percentage of the host.
SPECTRA_JAVA_OPTS=-Xms256m -Xmx1024m -XX:+UseZGC

# Retrieval is off for the Explorer's audits: their prompt already carries every message they
# reason about. On, they also read what Spectra has indexed above. The collection follows
# SPECTRA_STREAM_COLLECTION unless overridden here — and with use-rag false, Spectra answers
# directly and never looks at a collection at all.
EXPLORER_USE_RAG=false
EXPLORER_RAG_COLLECTION=

# GPU (docker-compose-spectra-hub.gpu.yml). Pinned to the SAME llama.cpp build as the CPU image
# above: a floating `server-cuda` would put a different engine revision under a stack that pins
# everything else. Bump the two together.
LLAMA_CPP_CUDA_IMAGE_TAG=server-cuda-b9828

# Memory limits (docker-compose-spectra-hub.limits.yml). Read only if that overlay is layered on;
# EXPLORER_MEM_LIMIT / EXPLORER_CPUS / KAFKA_MEM_LIMIT / KAFKA_CPUS above are shared with it.
# Deliberately no cpus for the llama.cpp servers: on CPU inference, throughput IS the core count.
LLM_CHAT_MEM_LIMIT=8g
LLM_EMBED_MEM_LIMIT=2g
CHROMADB_MEM_LIMIT=4g
SPECTRA_API_MEM_LIMIT=4g
FRONTEND_MEM_LIMIT=256m

# LEAVE EMPTY. Setting it makes Spectra require an X-API-Key header, which the Explorer does
# not send — it sends `Authorization: Bearer`, so Process Mining would answer 401 while
# everything else kept working. Neither application authenticates: keep BIND_ADDR on the
# loopback, or put something authenticating in front of the stack.
SPECTRA_API_KEY=

# ── Notes ────────────────────────────────────────────────────────────────────────────
# KAFKA_PORT also rewrites the broker's advertised PLAINTEXT_HOST listener, so a host
# client told to connect on the new port is not redirected back to 9092. The in-network
# listener (kafka:29092) is unaffected and is what the app itself uses.
#
# docker-compose-spectra.yml defaults EXPLORER_PORT to 8090 instead, because SpectraLLM's
# own API publishes on host 8080 in that stack.
#
# docker-compose-spectra-hub.yml keeps EXPLORER_PORT at 8080 and moves SpectraLLM's API to
# 8081 instead, since nothing there is built and the two projects' ports are chosen together.

# ── The developer SpectraLLM stack (docker-compose-spectra.yml) ──────────────────────────
# That file `include:`s SpectraLLM's own compose from a sibling checkout and builds the
# Explorer from source, where docker-compose-spectra-hub.yml pulls both from Docker Hub.
# Point this at the checkout if it does not sit next to this repository.
SPECTRALLM_DIR=../SpectraLLM
