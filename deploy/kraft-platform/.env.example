# Copier en `.env` à côté du docker-compose.yml, puis ajuster.
# `docker compose` le lit automatiquement.

# Préfixe du miroir d'images interne (mettre à vide pour tirer depuis Docker Hub)
REGISTRY=nx-repo.vinci-autoroutes.com/docker-group

# Confluent Platform 8.3 embarque Apache Kafka 4.2.
# Tags 8.x publiés au 2026-08-06 : 8.0.6, 8.1.3, 8.1.4, 8.2.1, 8.2.2, 8.3.0
CONFLUENT_VERSION=8.3.0

# Épinglée séparément : Confluent ne publie plus cp-ksqldb-cli au-delà de 8.0.x
# (8.1 / 8.2 / 8.3 renvoient 404 sur le registre). Écart sans conséquence, la
# CLI parle au serveur en REST.
KSQLDB_CLI_VERSION=8.0.6

# Hostname annoncé aux clients HORS du réseau docker `dip`.
# C'est ce que les producteurs/consommateurs doivent pouvoir résoudre.
KAFKA_EXTERNAL_HOST=kafkadev

# Identité du cluster KRaft. Doit rester stable tant que le volume de données
# existe. Générer un nouvel id : docker run --rm <image cp-kafka> kafka-storage random-uuid
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw

# Nom du jar de l'agent Prometheus présent dans ./jmx-exporter/
# (l'ancienne stack utilisait 0.20.0 ; 1.4.0 est la ligne maintenue)
JMX_AGENT_JAR=jmx_prometheus_javaagent-0.20.0.jar

# Dernière release AKHQ (image du 2026-05-12, même digest que `latest`)
AKHQ_VERSION=0.27.1

# Profil `observability` uniquement — tags alignés sur `latest` au 2026-08-06
PROMETHEUS_VERSION=v3.13.2
GRAFANA_VERSION=13.1.2
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
