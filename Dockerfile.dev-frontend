FROM node:26.6.0-alpine
WORKDIR /app
# npm's cache lives in a named volume (see docker-compose-dev.yml) rather than in the
# container's writable layer, so a rebuilt container does not re-download the tree.
ENV npm_config_cache=/npm-cache
# `npm install` ran on every start, against a bind-mounted /app. Two consequences:
# node_modules was written into the host checkout (root-owned on Linux, and holding
# Linux-native esbuild/rollup binaries that break a host-side `npm run dev`), and the
# install was paid again at each restart. node_modules is now a volume, and the install
# only runs when that volume is empty. `--host 0.0.0.0` is what makes the dev server
# reachable from outside the container; it defaults to loopback.
CMD ["sh", "-c", "[ -e node_modules/.package-lock.json ] || npm ci --no-audit --no-fund; exec npm run dev -- --host 0.0.0.0"]
