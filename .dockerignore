# `node_modules/` (without the globstar) only matches the repository root, and the
# real one lives at src/main/webapp/node_modules — a developer who had run `npm
# install` was shipping a few hundred MB of it into every build context.
**/node_modules
target/
.git/
.github/
.idea/
.vscode/
*.iml
.DS_Store

# Generated by a local `npm run build` / `mvn package`. The image builds the SPA in
# its own stage and copies the result here, and `COPY` merges into a directory
# rather than replacing it — so a stale local build would leave orphaned assets
# (an old index.html referencing hashed chunks that no longer exist) in the image.
src/main/resources/static/

# Build/run artefacts and unrelated payloads that only make the context bigger.
*.log
clusterui.zip

# Nothing the image build reads. The backend stage copies src/main/java and
# src/main/resources only, and the whole context is uploaded to the daemon on every
# build — half a megabyte of documentation and tooling was travelling with it each time.
src/test/
docs/
deploy/
*.md
*.skill
*.ps1
*.bat
.claude/
.gemini
.mvn/
mvnw
mvnw.cmd
